{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    },
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src/worker",
    "src/shared",
    "tests",
    "vitest.config.ts"
  ]
}